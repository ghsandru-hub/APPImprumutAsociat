Options -Indexes
PassengerEnabled On
PassengerAppRoot "/home/aiallro/loancopilot_app"
PassengerBaseURI "/"
PassengerPython "/home/aiallro/virtualenv/loancopilot_app/3.11/bin/python"
PassengerAppType wsgi
PassengerStartupFile passenger_wsgi.py
PassengerAppEnv production

RewriteEngine On
RewriteRule (^|/)\. - [F,L]

<FilesMatch "^(\.env|.*\.sqlite|.*\.db|.*\.ini|.*\.log|requirements\.txt)$">
  Require all denied
</FilesMatch>
